/* Reset básico */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Contenedor principal */
.about.page {
  position: relative;
  padding: 0;
  background-color: #fff;
  color: #000;
  min-height: 100vh;
  overflow-x: hidden;
}

/* Layout flexbox */
.about .d-f {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 4rem;
  position: relative;
}

/* Sección superior */
.about .top {
  padding: 120px 7vw;
  position: relative;
}

/* Contenedor de imagen */
.about .top .img {
  width: 50%;
  position: relative;
  overflow: hidden;
}

.show-outer,
.show-inner {
  width: 100%;
  height: 100%;
  position: relative;
}

.about .top img {
  width: 100%;
  height: auto;
  display: block;
}

/* Título y texto principal */
.about .top article {
  width: 45%;
  position: relative;
  max-width: 600px;
}

.about .top h1 {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
  color: #000;
  line-height: 1.2;
}

.about .top h2 {
  font-size: 1.5rem;
  margin-bottom: 2rem;
  color: #666;
}

.about .top .h4 {
  font-size: 1.2rem;
  display: block;
  margin-bottom: 0.5rem;
}

.about .top .strong {
  font-size: 2.5rem;
  font-weight: bold;
  margin-bottom: 1rem;
  line-height: 1.2;
}

.about .top p {
  font-size: 1.1rem;
  line-height: 1.5;
}

.about .top p span {
  display: block;
  margin-bottom: 0.5rem;
}

/* Sección descripción */
.about .desc {
  padding: 80px 7vw;
  text-align: center;
  background: #f8f8f8;
}

.about .desc article {
  max-width: 800px;
  margin: 0 auto;
  position: relative;
  padding: 0 20px;
}

.about .desc .h4 {
  font-size: 2rem;
  margin-bottom: 2rem;
  color: #000;
}

.about .desc p {
  font-size: 1.2rem;
  line-height: 1.8;
  color: #333;
  margin: 0 auto;
  max-width: 800px;
}

/* Banner de marcas */
.collabs {
  width: 100%;
  overflow: hidden;
  padding: 60px 0;
  background: #fff;
  border-top: 1px solid #eee;
  border-bottom: 1px solid #eee;
}

.collaborations {
  display: flex;
  list-style: none;
  animation: scroll 30s linear infinite;
  white-space: nowrap;
}

.collaborations li {
  flex: 0 0 auto;
  padding: 0 40px;
  font-size: 1.5rem;
  color: #666;
  font-weight: 500;
}

@keyframes scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

/* Reconocimientos */
.recognitions {
  padding: 80px 7vw;
}

.recognitions .title h3 {
  font-size: 2rem;
  margin-bottom: 2rem;
}

.recognitions h4 {
  font-size: 1.5rem;
  margin-bottom: 1rem;
}

.awards {
  list-style: none;
}

.awards li {
  margin-bottom: 1.5rem;
}

.awards strong {
  display: block;
  font-size: 1.2rem;
  margin-bottom: 0.3rem;
}

.awards span {
  color: #666;
}

/* Footer */
footer {
  padding: 80px 7vw;
  background: #000;
  color: #fff;
}

footer .big {
  font-size: 3rem;
  margin-bottom: 4rem;
  display: block;
}

footer .content {
  display: flex;
  gap: 4rem;
}

footer .img {
  width: 50%;
  position: relative;
}

footer .img img,
footer .img video {
  width: 100%;
  height: auto;
  display: block;
}

footer .link {
  position: absolute;
  bottom: 2rem;
  left: 2rem;
  color: #fff;
  text-decoration: none;
  font-size: 1.2rem;
  padding: 0.5rem 1rem;
  border: 2px solid #fff;
  transition: all 0.3s ease;
}

footer .link:hover {
  background: #fff;
  color: #000;
}

footer .top {
  width: 45%;
}

footer .line {
  display: flex;
  justify-content: space-between;
  font-size: 2rem;
  margin-bottom: 1rem;
}

footer .red {
  color: #ff0000;
}

@media (max-width: 768px) {
  .about .d-f {
    flex-direction: column;
    gap: 2rem;
  }

  .about .top .img,
  .about .top article {
    width: 100%;
  }

  .about .top h1 {
    font-size: 2rem;
  }

  .about .top .strong {
    font-size: 2rem;
  }

  .about .desc {
    padding: 60px 20px;
  }

  .about .desc p {
    font-size: 1.1rem;
  }

  .collaborations li {
    padding: 0 20px;
    font-size: 1.2rem;
  }

  footer .content {
    flex-direction: column;
  }

  footer .img,
  footer .top {
    width: 100%;
  }

  footer .big {
    font-size: 2rem;
  }

  footer .line {
    font-size: 1.5rem;
  }
}
