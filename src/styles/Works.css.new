/* Works Page */
.works-page {
  min-height: 100vh;
  background: #fff;
  color: #000;
  position: relative;
  overflow: hidden;
}

/* Progress Bar */
.progress {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 1px;
  background: #000;
  transform-origin: 0 50%;
  z-index: 1000;
}

/* Navigation */
.works-nav {
  position: fixed;
  top: 2rem;
  left: 2rem;
  z-index: 100;
}

.home-link {
  font-size: 1rem;
  color: #000;
  text-decoration: none;
  font-weight: 500;
  opacity: 0.7;
  transition: opacity 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.home-link:hover {
  opacity: 1;
}

/* Works Container */
.works {
  padding: 15vh 0;
  min-height: 100vh;
}

.container {
  max-width: 1600px;
  margin: 0 auto;
  padding: 0 10vw;
  position: relative;
}

/* Lines and Project Links */
.screen {
  position: relative;
  z-index: 2;
}

.lines-container {
  display: flex;
  flex-direction: column;
  margin-top: 10vh;
}

.line {
  padding: 0.5vh 0;
  opacity: 1;
  transform-origin: 0 50%;
  transition: all 0.3s ease;
  position: relative;
  margin-bottom: 2vh;
}

.work-link {
  display: block;
  position: relative;
  cursor: pointer;
  padding-left: 60px;
}

.number {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 14px;
  color: #666;
  font-weight: 500;
  opacity: 0.5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.label {
  font-family: "Times New Roman", serif;
  font-size: 8vw;
  color: #000;
  text-decoration: none;
  font-weight: 400;
  transition: all 0.3s ease;
  line-height: 1;
  position: relative;
  display: inline-block;
}

.category {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 1rem;
  color: #666;
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 400;
  white-space: nowrap;
}

.slash {
  opacity: 0.5;
  margin: 0 0.5rem;
}

.line:hover .label {
  opacity: 0.5;
  transform: translateX(20px);
}

/* Project Images */
.work-img {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10vh 10vw;
}

.img {
  width: 45vw;
  height: 65vh;
  opacity: 0;
  transform: scale(0.95);
  transition: all 0.5s ease;
  position: relative;
}

.img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 4px;
  filter: grayscale(0.2) contrast(1.1);
}

/* Scroll Hint */
.scroll-hint {
  position: fixed;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  background: none;
  border: none;
  color: #666;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  opacity: 0.7;
  transition: opacity 0.3s ease;
  padding: 1rem;
  z-index: 3;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.scroll-hint:hover {
  opacity: 1;
}

/* Media Queries */
@media (max-width: 1400px) {
  .label {
    font-size: 7vw;
  }
}

@media (max-width: 1200px) {
  .label {
    font-size: 6vw;
  }

  .img {
    width: 60vw;
  }
}

@media (max-width: 768px) {
  .works {
    padding: 10vh 0;
  }

  .container {
    padding: 0 5vw;
  }

  .label {
    font-size: 8vw;
  }

  .work-link {
    padding-left: 40px;
  }

  .number {
    font-size: 12px;
  }

  .category {
    position: relative;
    top: auto;
    right: auto;
    transform: none;
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }

  .img {
    width: 80vw;
    height: 50vh;
  }

  .line {
    padding: 1rem 0;
  }
}

/* Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.line {
  animation: fadeIn 0.5s ease forwards;
}

/* Smooth Scroll */
html {
  scroll-behavior: smooth;
}
